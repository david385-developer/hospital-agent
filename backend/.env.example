# backend/.env.example
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?appName=Cluster0

# Groq API Key for LLM Orchestration
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cloudinary Credentials for PDF Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Authentication Config
JWT_SECRET=super_secret_jwt_signing_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Vector DB Persist Directory
CHROMA_PERSIST_DIR=./chroma_db
